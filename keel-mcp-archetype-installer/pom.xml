<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.keelframework.mcp</groupId>
        <artifactId>keel-mcp-java</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>keel-mcp-archetype-installer</artifactId>
    <version>${keel-mcp-archetype-installer.version}</version>
    <packaging>jar</packaging>
    <name>MCP Archetype Installer</name>
    <description>
        CLI installer for "mvn archetype:generate" for mcp-server-archetype with simplified parameters: artifactId, domain, transport, appVersion.
    </description>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mcp.archetype.version>1.0.0</mcp.archetype.version>
    </properties>



    <!-- NEW: forces Maven to build mcp-server-archetype BEFORE this
         module within the same reactor (so that its jar/pom exist
         in target/ when this pom attempts to copy them) -->
    <dependencies>
        <dependency>
            <groupId>io.keelframework.mcp</groupId>
            <artifactId>keel-mcp-archetype</artifactId>
            <version>${keel-mcp-archetype.version}</version>
            <type>jar</type>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>

        <!-- Filters archetype.properties to replace @mcp.archetype.version@
             (the @...@ delimiter inherited from spring-boot-starter-parent, not ${...})
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>archetype.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>archetype.properties</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-license-headers</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <!-- Required so that MvnArchetype.getClass().getPackage()
                             .getImplementationVersion() returns ${project.version}
                        -->
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <mainClass>io.keelframework.mcp.develop.archetype.MvnArchetype</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>


</project>