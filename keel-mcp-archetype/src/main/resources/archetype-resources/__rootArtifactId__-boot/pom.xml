<?xml version="1.0" encoding="UTF-8"?>
#set( $symbol_dollar = '$' )
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}</artifactId>
        <version>${version}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>${rootArtifactId}-boot</artifactId>
    <name>${rootArtifactId}-boot</name>
    <packaging>war</packaging>
    <description>MCP Server Boot — ${rootArtifactId}</description>

    <dependencies>

        <!-- Config Server client -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Módulo con las tools/resources/prompts MCP de este proyecto -->
        <dependency>
            <groupId>${groupId}</groupId>
            <artifactId>${rootArtifactId}-mcp</artifactId>
            <version>${version}</version>
        </dependency>

        <!-- ============================================ -->
        <!-- FRAMEWORK — Transport Streamable MVC    -->
        <!-- Incluye transitivamente:                    -->
        <!--   transport-auth-service  → JWT + Security  -->
        <!--   transport-session-service → sesión        -->
        <!--   adapter-auth-idp → validación JWT         -->
        <!--   adapter-cache-caffeine → caché            -->
        <!-- ============================================ -->
        <dependency>
            <groupId>io.keelframework.mcp.transport</groupId>
            <artifactId>keel-transport-streamable-mvc</artifactId>
        </dependency>

        <!-- CORS es opcional — el proyecto lo añade solo si expone /mcp a un navegador -->
        <dependency>
            <groupId>io.keelframework.mcp.transport</groupId>
            <artifactId>keel-transport-cors-service</artifactId>
        </dependency>

        <!-- ============================================ -->
        <!-- Observabilidad — Logging Auth                -->
        <!-- ============================================ -->
        <dependency>
            <groupId>io.keelframework.mcp.observability</groupId>
            <artifactId>keel-observability-logging</artifactId>
        </dependency>

        <!-- ============================================ -->
        <!-- LOMBOK                                      -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ============================================ -->
        <!-- TEST                                        -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${symbol_dollar}{java.version}</source>
                    <target>${symbol_dollar}{java.version}</target>
                    <compilerArgs>
                        <arg>-proc:full</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- repackage: genera el jar ejecutable, solo aplica en el módulo boot -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
