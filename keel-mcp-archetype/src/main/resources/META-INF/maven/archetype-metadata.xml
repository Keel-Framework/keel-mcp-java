<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor
        xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0
        https://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd"
        name="mcp-server-archetype">

    <requiredProperties>

        <requiredProperty key="artifactId">
            <defaultValue>${microName}</defaultValue>
        </requiredProperty>

        <requiredProperty key="architectureVersion">
            <defaultValue>1.0.0</defaultValue>
        </requiredProperty>

        <requiredProperty key="version"/>

        <requiredProperty key="micro">
            <validationRegex>^[a-z0-9]*$</validationRegex>
        </requiredProperty>

        <requiredProperty key="microName">
            <validationRegex>^[a-zA-Z0-9\-]*$</validationRegex>
        </requiredProperty>

        <requiredProperty key="domain">
            <validationRegex>^[a-z0-9]*$</validationRegex>
        </requiredProperty>

        <requiredProperty key="domainName">
            <validationRegex>^[a-zA-Z0-9\-]*$</validationRegex>
        </requiredProperty>

        <requiredProperty key="groupId">
            <!-- SIN defaultValue derivado de domain/micro -->
            <validationRegex>^[a-zA-Z][a-zA-Z0-9.]*$</validationRegex>
        </requiredProperty>

        <requiredProperty key="package">
            <defaultValue>${groupId}</defaultValue>
        </requiredProperty>

        <requiredProperty key="transport">
            <defaultValue>mvc</defaultValue>    <!--  mvc o webflux  -->
        </requiredProperty>

    </requiredProperties>

    <fileSets>

        <!-- pom.xml raíz (agregador, packaging=pom, <modules>) -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory></directory>
            <includes>
                <include>pom.xml</include>
            </includes>
        </fileSet>


        <!-- Deploy:  Dockerfile -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory></directory>
            <includes>
                <include>Dockerfile</include>
            </includes>
        </fileSet>

        <!-- ===================== Módulo boot ===================== -->

        <fileSet filtered="true" encoding="UTF-8">
            <directory>__rootArtifactId__-boot</directory>
            <includes>
                <include>pom.xml</include>
            </includes>
        </fileSet>

        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>__rootArtifactId__-boot/src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>

        <fileSet filtered="true" encoding="UTF-8">
            <directory>__rootArtifactId__-boot/src/main/resources</directory>
            <includes>
                <include>**/*.yml</include>
                <include>**/*.yaml</include>
                <include>**/*.properties</include>
            </includes>
        </fileSet>

        <!-- JKS —   -->
        <fileSet filtered="false" encoding="UTF-8">
            <directory>__rootArtifactId__-boot/src/main/resources</directory>
            <includes>
                <include>**/*.jks</include>
            </includes>
        </fileSet>

        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>__rootArtifactId__-boot/src/test/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>

        <!-- ===================== MCP.jar ===================== -->

        <fileSet filtered="true" encoding="UTF-8">
            <directory>__rootArtifactId__-mcp</directory>
            <includes>
                <include>pom.xml</include>
            </includes>
        </fileSet>

        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>__rootArtifactId__-mcp/src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>

        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>__rootArtifactId__-mcp/src/test/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>

        <!-- ===================== Model.JAR ===================== -->

        <fileSet filtered="true" encoding="UTF-8">
            <directory>__rootArtifactId__-model</directory>
            <includes>
                <include>pom.xml</include>
            </includes>
        </fileSet>

        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>__rootArtifactId__-model/src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>

    </fileSets>

</archetype-descriptor>
